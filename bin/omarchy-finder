#!/usr/bin/env bash
# omarchy-finder: Spotlight-style finder for Omarchy.
#
#   omarchy-finder            run the picker in the current terminal
#   omarchy-finder --launch   open the picker in a floating terminal (hotkey target)
#   omarchy-finder --search Q internal: print matches for Q (used by fzf reload)
#
# Keys inside the picker:
#   Enter        open the selected file or folder with its default app
#   Ctrl-O       reveal the selection in the file manager
#   Ctrl-Y       copy the selected path to the clipboard
#   Ctrl-E       compose a Gmail message: words with @ are recipients, the rest
#                is the subject ("bob@example.com invoice for august")
#   Ctrl-W       web search the typed text
#   Esc          close
#
# Type a math expression (245+33*16, (1200*0.07)/12, 2^10) and the answer
# appears as the first row; Enter copies it to the clipboard.
#
# Type a command name, optionally with arguments (chrome, "obsidian ~/notes",
# "google-chrome-stable --incognito https://x"), and a "▶ run" row appears;
# Enter launches it. Names map through ~/.config/omarchy-finder/command-aliases.
#
# Matching is done by plocate against the system index, so results are instant
# on a large home directory. The index is refreshed nightly by
# plocate-updatedb.timer; run `sudo updatedb` to refresh it by hand.
set -uo pipefail

root="${FINDER_ROOT:-$HOME}"
limit="${FINDER_LIMIT:-400}"
mail_url="${FINDER_MAIL_URL:-https://mail.google.com/mail/?view=cm&fs=1}"
web_url="${FINDER_WEB_URL:-https://www.google.com/search?q=}"
exclude='/(\.git|node_modules|\.cache|\.npm|\.nuget|\.cargo|\.rustup|\.local/share/(mise|Trash|containers)|bin/(Debug|Release)|obj)(/|$)'

# Command launcher: type a command name (optionally with args) and a run row
# appears. These aliases map friendly names to real binaries; add your own in
# ~/.config/omarchy-finder/command-aliases as "name=binary" lines.
declare -A CMD_ALIASES=(
  [chrome]=google-chrome-stable
  [google-chrome]=google-chrome-stable
)
_alias_file="$HOME/.config/omarchy-finder/command-aliases"
if [[ -r $_alias_file ]]; then
  while IFS='=' read -r _n _b; do
    [[ -z $_n || $_n == \#* ]] && continue
    CMD_ALIASES[$_n]=$_b
  done < "$_alias_file"
fi

# Commands that need a terminal: the run row opens them in a floating terminal
# instead of launching as a GUI app. Extend via
# ~/.config/omarchy-finder/terminal-commands (one name per line).
declare -A TERM_CMDS=()
for _t in btop htop top btm nvtop nvim vim vi nano micro emacs helix hx \
          less more man ssh mosh ranger yazi nnn lf lazygit lazydocker gitui \
          tig ncdu tmux screen python python3 ipython node irb bat w3m lynx; do
  TERM_CMDS[$_t]=1
done
_term_file="$HOME/.config/omarchy-finder/terminal-commands"
if [[ -r $_term_file ]]; then
  while read -r _t; do [[ -z $_t || $_t == \#* ]] && continue; TERM_CMDS[$_t]=1; done < "$_term_file"
fi

urlencode() {
  local s="$1" out="" c
  for (( i = 0; i < ${#s}; i++ )); do
    c=${s:i:1}
    case $c in
      [a-zA-Z0-9.~_-]) out+="$c" ;;
      ' ') out+="+" ;;
      *) printf -v c '%%%02X' "'$c"; out+="$c" ;;
    esac
  done
  printf '%s' "$out"
}

calc() {
  local expr="$1" out
  [[ $expr =~ ^[0-9[:space:]+*/().%^-]+$ && $expr =~ [0-9] && $expr =~ [-+*/%^] ]] || return 1
  # The regex above admits only digits, spaces, and arithmetic operators, so
  # the expression is safe to hand to awk verbatim.
  out=$(awk "BEGIN { printf \"%.10g\", ($expr) }" 2>/dev/null) || return 1
  [[ -n $out && $out != *inf* && $out != *nan* ]] || return 1
  printf '= %s\n' "$out"
}

# If the query's first word is a runnable command (or a known alias), emit a
# run row. Enter on it launches the whole line as a GUI app.
runcmd() {
  local q="$1" first target bin rest
  first=${q%% *}
  [[ -z $first ]] && return 1
  target=${CMD_ALIASES[$first]:-$first}
  bin=$(command -v "$target") || return 1
  if [[ $first == "$target" ]]; then
    printf '\u25b6 %s\n' "$q"
  else
    rest=${q#"$first"}
    printf '\u25b6 %s%s\n' "$target" "$rest"
  fi
}

search() {
  local q="$1" words
  [[ -z ${q// } ]] && return 0
  calc "$q" || true
  runcmd "$q" || true
  read -r -a words <<<"$q"
  plocate -i -l 4000 -- "$root/" "${words[@]}" 2>/dev/null \
    | grep -Ev "$exclude" \
    | head -n "$limit" \
    | sed "s|^$root/|~/|"
}

expand() { printf '%s' "${1/#\~\//$root/}"; }

# Words containing @ are recipients; everything else is the subject.
#   "bob@example.com invoice for august"  ->  to=bob@example.com  su=invoice for august
mail_compose_url() {
  local word to="" subject=""
  for word in $1; do
    if [[ $word == *@* ]]; then
      to+="${to:+,}${word%,}"
    else
      subject+="${subject:+ }$word"
    fi
  done
  printf '%s' "$mail_url"
  [[ -n $to ]] && printf '&to=%s' "$(urlencode "$to")"
  [[ -n $subject ]] && printf '&su=%s' "$(urlencode "$subject")"
}

# Launch a parsed command line: terminal apps in a floating terminal, GUI apps
# directly.
launch_run() {
  local b; b=$(basename "${1:-}")
  if [[ -n ${TERM_CMDS[$b]:-} ]] && command -v omarchy-launch-tui >/dev/null; then
    [[ -n ${FINDER_DEBUG:-} ]] && printf '%s run(tui): %q\n' "$(date +%T)" "$*" >> "$FINDER_DEBUG"
    omarchy-launch-tui --app-id=org.omarchy.terminal "$@" >/dev/null 2>&1
  else
    launch_detached "$@"
  fi
}

launch_detached() {
  [[ -n ${FINDER_DEBUG:-} ]] && printf '%s launch: %q\n' "$(date +%T)" "$*" >> "$FINDER_DEBUG"
  # uwsm-app hands the command to the session's app daemon and returns; the
  # app outlives this terminal. Backgrounding it here races the terminal
  # closing and the request never gets sent.
  uwsm-app -- "$@" >/dev/null 2>&1
}

case "${1:-}" in
  --search)
    search "${2:-}"
    exit 0
    ;;
  --preview)
    _arg="${2:-}"
    if [[ $_arg == \u25b6\ * || $_arg == "▶ "* ]]; then
      _cmd="${_arg#* }"; _first="${_cmd%% *}"
      echo "Run command:"; echo; echo "  $_cmd"; echo
      _bin=$(command -v "$_first" 2>/dev/null); echo "Resolves to: ${_bin:-not found}"
      [[ -n ${TERM_CMDS[$(basename "${_bin:-$_first}")]:-} ]] && echo "Opens in a floating terminal."
      [[ -n $_bin ]] && file -b "$_bin" 2>/dev/null
      exit 0
    fi
    exec bash "$(dirname "$(readlink -f "$0")")/omarchy-finder-preview" "$(expand "$_arg")"
    ;;
  --launch)
    exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.omarchy.finder --title=Finder -e "$0"
    ;;
esac

for cmd in plocate fzf xdg-open; do
  command -v "$cmd" >/dev/null || { echo "omarchy-finder: missing $cmd" >&2; exit 1; }
done

self=$(readlink -f "$0")
result=$(
  fzf --disabled --print-query --no-sort --exact \
    --prompt '  ' --header '⏎ open · ^O reveal · ^Y copy · ^E email · ^W web · esc close' \
    --header-first --info hidden --layout reverse --border none --margin 1,2 \
    --expect ctrl-o,ctrl-y,ctrl-e,ctrl-w \
    --bind "change:reload(bash '$self' --search {q})" \
    --preview "bash '$self' --preview {}" \
    --preview-window 'right,45%,border-left' </dev/null
)
status=$?
if [[ -n ${FINDER_DEBUG:-} ]]; then
  printf '%s status=%s result=%q\n' "$(date +%T)" "$status" "$result" >> "$FINDER_DEBUG"
fi
query=$(sed -n 1p <<<"$result")
key=$(sed -n 2p <<<"$result")
sel=$(sed -n 3p <<<"$result")
path=$(expand "$sel")

case "$key" in
  ctrl-e) launch_detached xdg-open "$(mail_compose_url "$query")" ;;
  ctrl-w) [[ -n $query ]] && launch_detached xdg-open "${web_url}$(urlencode "$query")" ;;
  ctrl-y) [[ -n $sel && $sel != "= "* && $sel != "▶ "* ]] && printf '%s' "$path" | wl-copy ;;
  ctrl-o) [[ -n $sel && $sel != "= "* && $sel != "▶ "* ]] && launch_detached xdg-open "$(dirname "$path")" ;;
  "")
    if [[ $sel == "= "* ]]; then
      printf '%s' "${sel#= }" | wl-copy
    elif [[ $sel == "▶ "* ]]; then
      # Run row: split the command line into argv and launch it.
      read -r -a _argv <<<"${sel#▶ }"
      (( ${#_argv[@]} )) && launch_run "${_argv[@]}"
    elif [[ $status -eq 0 && -n $sel ]]; then
      launch_detached xdg-open "$path"
    fi
    ;;
esac
exit 0
