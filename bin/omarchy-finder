#!/usr/bin/env bash
# omarchy-finder: Spotlight-style finder for Omarchy.
#
#   omarchy-finder            run the picker in the current terminal
#   omarchy-finder --launch   open the picker in a floating terminal (hotkey target)
#   omarchy-finder --search Q internal: print matches for Q (used by fzf reload)
#
# Keys inside the picker:
#   Enter        open the selected file or folder with its default app
#   Ctrl-O       reveal the selection in the file manager
#   Ctrl-Y       copy the selected path to the clipboard
#   Ctrl-E       compose a Gmail message; the typed text becomes the subject
#   Ctrl-W       web search the typed text
#   Esc          close
#
# Type a math expression (245+33*16, (1200*0.07)/12, 2^10) and the answer
# appears as the first row; Enter copies it to the clipboard.
#
# Matching is done by plocate against the system index, so results are instant
# on a large home directory. The index is refreshed nightly by
# plocate-updatedb.timer; run `sudo updatedb` to refresh it by hand.
set -uo pipefail

root="${FINDER_ROOT:-$HOME}"
limit="${FINDER_LIMIT:-400}"
mail_url="${FINDER_MAIL_URL:-https://mail.google.com/mail/?view=cm&fs=1&su=}"
web_url="${FINDER_WEB_URL:-https://www.google.com/search?q=}"
exclude='/(\.git|node_modules|\.cache|\.npm|\.nuget|\.cargo|\.rustup|\.local/share/(mise|Trash|containers)|bin/(Debug|Release)|obj)(/|$)'

urlencode() {
  local s="$1" out="" c
  for (( i = 0; i < ${#s}; i++ )); do
    c=${s:i:1}
    case $c in
      [a-zA-Z0-9.~_-]) out+="$c" ;;
      ' ') out+="+" ;;
      *) printf -v c '%%%02X' "'$c"; out+="$c" ;;
    esac
  done
  printf '%s' "$out"
}

calc() {
  local expr="$1" out
  [[ $expr =~ ^[0-9[:space:]+*/().%^-]+$ && $expr =~ [0-9] && $expr =~ [-+*/%^] ]] || return 1
  # The regex above admits only digits, spaces, and arithmetic operators, so
  # the expression is safe to hand to awk verbatim.
  out=$(awk "BEGIN { printf \"%.10g\", ($expr) }" 2>/dev/null) || return 1
  [[ -n $out && $out != *inf* && $out != *nan* ]] || return 1
  printf '= %s\n' "$out"
}

search() {
  local q="$1" words
  [[ -z ${q// } ]] && return 0
  calc "$q" || true
  read -r -a words <<<"$q"
  plocate -i -l 4000 -- "$root/" "${words[@]}" 2>/dev/null \
    | grep -Ev "$exclude" \
    | head -n "$limit" \
    | sed "s|^$root/|~/|"
}

expand() { printf '%s' "${1/#\~\//$root/}"; }

launch_detached() {
  [[ -n ${FINDER_DEBUG:-} ]] && printf '%s launch: %q\n' "$(date +%T)" "$*" >> "$FINDER_DEBUG"
  # uwsm-app hands the command to the session's app daemon and returns; the
  # app outlives this terminal. Backgrounding it here races the terminal
  # closing and the request never gets sent.
  uwsm-app -- "$@" >/dev/null 2>&1
}

case "${1:-}" in
  --search)
    search "${2:-}"
    exit 0
    ;;
  --preview)
    exec bash "$(dirname "$(readlink -f "$0")")/omarchy-finder-preview" "$(expand "${2:-}")"
    ;;
  --launch)
    exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.omarchy.finder --title=Finder -e "$0"
    ;;
esac

for cmd in plocate fzf xdg-open; do
  command -v "$cmd" >/dev/null || { echo "omarchy-finder: missing $cmd" >&2; exit 1; }
done

self=$(readlink -f "$0")
result=$(
  fzf --disabled --print-query --no-sort --exact \
    --prompt '  ' --header '⏎ open · ^O reveal · ^Y copy · ^E email · ^W web · esc close' \
    --header-first --info hidden --layout reverse --border none --margin 1,2 \
    --expect ctrl-o,ctrl-y,ctrl-e,ctrl-w \
    --bind "change:reload(bash '$self' --search {q})" \
    --preview "bash '$self' --preview {}" \
    --preview-window 'right,45%,border-left' </dev/null
)
status=$?
if [[ -n ${FINDER_DEBUG:-} ]]; then
  printf '%s status=%s result=%q\n' "$(date +%T)" "$status" "$result" >> "$FINDER_DEBUG"
fi
query=$(sed -n 1p <<<"$result")
key=$(sed -n 2p <<<"$result")
sel=$(sed -n 3p <<<"$result")
path=$(expand "$sel")

case "$key" in
  ctrl-e) launch_detached xdg-open "${mail_url}$(urlencode "$query")" ;;
  ctrl-w) [[ -n $query ]] && launch_detached xdg-open "${web_url}$(urlencode "$query")" ;;
  ctrl-y) [[ -n $sel ]] && printf '%s' "$path" | wl-copy ;;
  ctrl-o) [[ -n $sel && $sel != "= "* ]] && launch_detached xdg-open "$(dirname "$path")" ;;
  "")
    if [[ $sel == "= "* ]]; then
      printf '%s' "${sel#= }" | wl-copy
    elif [[ $status -eq 0 && -n $sel ]]; then
      launch_detached xdg-open "$path"
    fi
    ;;
esac
exit 0
